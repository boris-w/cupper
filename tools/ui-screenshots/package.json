{
  "name": "@cupper/ui-screenshots",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "The UI's screenshot regression: ui-core on the browser ShellAPI and the mock host, under the main document's CSP, with fixed fonts.",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:ui": "playwright test",
    "ui:baseline": "CUPPER_UI_BASELINE=1 playwright test --update-snapshots=changed"
