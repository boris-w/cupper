    "@cupper/host-client": "workspace:*",
    "@cupper/protocol": "workspace:*",
    "@cupper/shell-api": "workspace:*",
    "@cupper/ui-core": "workspace:*",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.19.1",
    "vite": "8.3.3",
    "vitest": "5.0.3"
  }
}
