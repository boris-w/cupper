{
  "name": "cupper",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "scripts": {
    "build:e2e": "pnpm --filter @cupper/desktop run build:e2e",
    "format": "cargo fmt --all && prettier --write .",
    "lint": "cargo fmt --all --check && cargo clippy --workspace --all-targets --all-features --locked -- -D warnings && prettier --check . && eslint --max-warnings=0 .",
    "test": "cargo test --workspace --all-features --locked"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.12.0",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1"
  }
}
