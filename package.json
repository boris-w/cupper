{
  "name": "cupper",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "scripts": {
    "build:e2e": "pnpm --filter @cupper/desktop run build:e2e",
    "format": "cargo fmt --all && prettier --write .",
    "gen": "cargo run --package cupper-protocol --bin export-schema --locked --quiet -- protocol/schema/v1.json && node tools/gen-protocol-ts/src/main.ts",
    "lint": "cargo fmt --all --check && cargo clippy --workspace --all-targets --all-features --locked -- -D warnings && prettier --check . && eslint --max-warnings=0 .",
    "test": "cargo test --workspace --all-features --locked",
    "test:e2e": "pnpm --filter @cupper/e2e run test:e2e",
    "test:golden": "cargo test -p cupper-host --features test-harness --locked gold_",
    "test:ui": "pnpm --filter @cupper/ui-screenshots run test:ui",
    "ui:baseline": "pnpm --filter @cupper/ui-screenshots run ui:baseline"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.12.0",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1"
  }
}
